<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/user_cell_container"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_user_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <include
        layout="@layout/user_info_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/kpi_uploads_container"
            style="@style/UserInfo_KpiContainer">

            <TextView
                android:id="@+id/kpi_uploads"
                style="@style/UserInfo_Kpi_Value"
                tools:text="56" />

            <TextView
                style="@style/UserInfo_Kpi_Header"
                android:text="@string/kpi_desc_uploads"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kpi_collected_container"
            style="@style/UserInfo_KpiContainer">

            <TextView
                android:id="@+id/kpi_collected"
                style="@style/UserInfo_Kpi_Value"
                tools:text="96" />

            <TextView
                style="@style/UserInfo_Kpi_Header"
                android:text="@string/kpi_desc_collected"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kpi_comments_container"
            style="@style/UserInfo_KpiContainer">

            <TextView
                android:id="@+id/kpi_comments"
                style="@style/UserInfo_Kpi_Value"
                tools:text="85" />

            <TextView
                style="@style/UserInfo_Kpi_Header"
                android:text="@string/kpi_desc_comments"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <LinearLayout style="@style/UserInfo_KpiContainer">

            <TextView
                android:id="@+id/kpi_tags"
                style="@style/UserInfo_Kpi_Value"
                tools:text="1827" />

            <TextView
                style="@style/UserInfo_Kpi_Header"
                android:text="@string/kpi_desc_tags"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/badges_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/action_new_message"
            style="@style/UserInfo_Action">

            <ImageView
                style="@style/UserInfo_Action_Icon"
                app:srcCompat="@drawable/ic_action_email" />

            <TextView
                style="@style/UserInfo_Action_Text"
                android:text="@string/user_action_message" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_share"
            style="@style/UserInfo_Action">

            <ImageView
                style="@style/UserInfo_Action_Icon"
                app:srcCompat="@drawable/ic_white_action_share" />

            <TextView
                style="@style/UserInfo_Action_Text"
                android:text="@string/share" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_block"
            style="@style/UserInfo_Action"
            android:tooltipText="@string/action_block_user_2">

            <ImageView
                style="@style/UserInfo_Action_Icon"
                app:srcCompat="@drawable/ic_action_block_user" />

            <TextView
                style="@style/UserInfo_Action_Text"
                android:text="@string/user_action_block" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/app_links"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
