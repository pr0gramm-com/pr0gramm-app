<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/search_term_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorPrimary"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:theme="?searchTheme">

        <ImageButton
            android:id="@+id/search_cancel"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="?actionBarSize"
            android:layout_height="?actionBarSize"
            app:srcCompat="@drawable/ic_white_action_back" />

        <com.pr0gramm.app.ui.views.PlainTextAutoCompleteTextView
            android:id="@+id/search_term"
            style="@style/SearchField"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/action_search_simple" />

        <ImageButton
            android:id="@+id/search_button"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="?actionBarSize"
            android:layout_height="?actionBarSize"
            android:contentDescription="@string/action_search_simple"
            app:srcCompat="@drawable/ic_white_action_search" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/extended_search_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_panel"
        android:clickable="true"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:theme="?searchTheme">

        <TextView
            android:id="@+id/minimum_score_label"
            style="@style/SearchLabel"
            android:layout_marginTop="16dp"
            android:text="@string/search_score_0" />

        <SeekBar
            android:id="@+id/minimum_score_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="4dp"
            android:progressTint="?colorAccent"
            android:thumbTint="?colorAccent" />

        <LinearLayout
            android:id="@+id/filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SearchLabel"
                android:layout_marginTop="16dp"
                android:text="@string/search_media" />

            <LinearLayout
                android:id="@+id/media_checks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/SearchLabel"
                android:layout_marginTop="16dp"
                android:text="@string/search_only" />

            <LinearLayout
                android:id="@+id/only_checks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/SearchLabel"
                android:layout_marginTop="16dp"
                android:text="@string/search_show_tags" />

            <LinearLayout
                android:id="@+id/without_checks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/SearchLabel"
                android:layout_marginTop="16dp"
                android:text="@string/search_without_custom_tags" />

            <com.pr0gramm.app.ui.views.PlainEditText
                android:id="@+id/custom_excludes"
                style="@style/SearchField"
                android:layout_width="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:hint="@string/search_custom_excludes_hint" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filters_toggle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/filters_toggle_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_more_filters"
                android:textAppearance="@style/TextAppearance.AppCompat.Body2" />

            <ImageView
                android:id="@+id/filters_toggle_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:rotation="180"
                app:srcCompat="@drawable/ic_arrow_up" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/search_reset"
                style="@style/SearchButton"
                android:text="@string/search_reset"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/search_advanced"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/search_advanced"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_white_action_help" />

            <Button
                android:id="@+id/search_submit"
                style="@style/SearchButton"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_search_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/action_search_simple"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
